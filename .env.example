# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# docker-compose overrides this to point at its own mongo service.
MONGODB_URI=mongodb://localhost:27017/resume_builder

# --- LLM --------------------------------------------------------------------
# anthropic | openai | openrouter | groq | ollama
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Only needed for LLM_PROVIDER=openrouter. Create a key in your OpenRouter account settings.
OPENROUTER_API_KEY=
# Any model slug from https://openrouter.ai/models that supports structured outputs.
OPENROUTER_MODEL=
# Only needed for LLM_PROVIDER=groq. Create a key at https://console.groq.com/keys (free tier).
GROQ_API_KEY=
# Groq model slug, e.g. mixtral-8x7b-32768, llama-3.1-70b-versatile, llama-3.1-8b-instant (all free).
GROQ_MODEL=
# Local, free: LLM_PROVIDER=ollama. Install Ollama, then: ollama pull qwen2.5:7b
# docker-compose points the backend at the Mac's Ollama; set OLLAMA_BASE_URL only for other setups.
OLLAMA_MODEL=qwen2.5:7b
# Context window in tokens (Ollama's own default of 4096 is too small for resume + JD).
OLLAMA_NUM_CTX=16384
# OLLAMA_BASE_URL=http://localhost:11434
# Only needed for LLM_PROVIDER=openai or EMBEDDINGS_PROVIDER=openai:
OPENAI_API_KEY=
# Required when LLM_PROVIDER=openai, e.g. the current GPT model name.
OPENAI_MODEL=

# --- ATS scoring & optimization ----------------------------------------------
ATS_THRESHOLD=90
# improve = rewrite when the score is BELOW the threshold (recommended)
# gate    = only produce a polished rewrite once the score is AT/ABOVE the threshold
OPTIMIZE_MODE=improve
MAX_OPTIMIZE_ITERATIONS=3
ATS_KEYWORD_WEIGHT=0.7
ATS_SEMANTIC_WEIGHT=0.3
# local = built-in term-vector similarity (no extra dependency) | openai = OpenAI embeddings
EMBEDDINGS_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional calibration: raw cosine similarity mapped from [floor, ceiling] onto 0-100.
# ATS_SEMANTIC_FLOOR=0.05
# ATS_SEMANTIC_CEILING=0.45

# --- Gmail (SMTP with an App Password) ----------------------------------------
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
